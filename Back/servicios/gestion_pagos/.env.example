PORT=4005
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
FACTURACION_URL=http://localhost:4002
JWT_SECRET=clave_de_minimo_32_caracteres
JWT_EXPIRES_IN_SEG=900

# Envio real de la factura por correo (emailService.js). Si se dejan vacias,
# el envio queda "simulado" (se arma el HTML pero no se manda nada).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM="TallerSis <tu_correo@gmail.com>"

# TDSI-51/179: ventas que publica el Marketplace (Grupo E) en NUESTRO topico (Grupo A,
# ucb-sis323-sub-a). La suscripcion Pull sobre ese topico es ucb-sis323-sub-a-sub (mismo
# patron "<topico>-sub" para cada grupo) -- la lee tambien Compras-acuses y Contabilidad
# abajo, cada integracion filtra lo suyo y libera el resto (vacio = no se leen).
MARKETPLACE_VENTAS_SUBSCRIPTION=projects/project-a96e5fe1-5ba6-4698-a85/subscriptions/ucb-sis323-sub-a-sub
MARKETPLACE_VENTAS_INTERVALO_SEG=15
# TDSI-51/684: aviso de factura emitida (N de orden + N de factura + enlace "Verificar
# Factura") que publicamos para el Marketplace (Grupo E) en SU topico (vacio = no se publica nada)
MARKETPLACE_FACTURAS_TOPIC=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-e
# TDSI-54/682: reporte de productos vendidos del dia, publicado para Compras y
# Proveedores (Grupo C) en SU topico (vacio = no se publica nada). No es COMPRAS_API_URL
# de pagos_proveedores (esa es otra integracion, HTTP, para confirmaciones de pago a proveedores).
COMPRAS_PUBSUB_TOPIC=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-c
# Credencial (una de las dos; el .env nunca se sube): la misma cuenta de servicio que
# ya usan facturacion, gestion_caja y pagos_proveedores (proyecto project-a96e5fe1-5ba6-4698-a85).
#  a) la llave pegada aqui en UNA sola linea y entre comillas simples (o en base64)
GOOGLE_CREDENTIALS_JSON=
#  b) ruta ABSOLUTA al JSON de la llave, guardado FUERA del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_TIMEOUT_MS=10000
# TDSI-54/697: acuses de Compras ("compras-acuses") que marcan un envio como Recibido --
# Compras los publica en NUESTRO topico (Grupo A); misma suscripcion que
# MARKETPLACE_VENTAS_SUBSCRIPTION (ucb-sis323-sub-a-sub), cada integracion filtra lo suyo.
COMPRAS_ACUSES_SUBSCRIPTION=projects/project-a96e5fe1-5ba6-4698-a85/subscriptions/ucb-sis323-sub-a-sub
COMPRAS_ACUSES_INTERVALO_SEG=30
# URL publica de este servicio, para que el enlace "Verificar Factura" (QR / Marketplace)
# no apunte a localhost. Vacio en desarrollo local = usa http://localhost:<PORT>.
PUBLIC_API_URL=
