PORT=4006
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
COMPRAS_API_URL=http://localhost:4999
COMPRAS_API_TOKEN=
COMPRAS_TIMEOUT_MS=5000
COMPRAS_MAX_INTENTOS=5
COMPRAS_BACKOFF_BASE_SEG=30
COMPRAS_INTERVALO_WORKER_SEG=15

# TDSI-21/415: Lote de Cierre Diario
GESTION_PAGOS_URL=http://localhost:4005
INTEGRACIONES_TIMEOUT_MS=5000
# true = no llama a los otros microservicios, usa datos simulados
MODO_AISLADO=false
# TDSI-416: IVA incluido en el precio de venta (%)
IVA_PORCENTAJE=13

# TDSI-636: Contabilidad (estado del periodo contable de la fecha del lote)
CONTABILIDAD_URL=http://localhost:4998
CONTABILIDAD_TOKEN=
# Solo con MODO_AISLADO=true: periodos que el receptor simulado responde como cerrados (ej. 2026-08,2026-09)
CONTABILIDAD_SIMULADO_CERRADOS=
# Solo con MODO_AISLADO=true: simula que Contabilidad no responde
CONTABILIDAD_SIMULAR_CAIDA=false