PORT=4002
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
DB_SSL=true
PIN_MAX_INTENTOS=3
PIN_BLOQUEO_MIN=15

# TDSI-22: envio de facturas (emitidas y anuladas) a Contabilidad - Grupo D (vacio = no se envian)
CONTABILIDAD_PUBSUB_TOPIC=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-d
# Credencial (una de las dos; el .env nunca se sube):
#  a) la llave pegada aqui en UNA sola linea y entre comillas simples (o en base64)
GOOGLE_CREDENTIALS_JSON=
#  b) ruta ABSOLUTA al JSON de la llave, guardado FUERA del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_TIMEOUT_MS=10000
CONTABILIDAD_MAX_INTENTOS=3
CONTABILIDAD_BACKOFF_BASE_SEG=30
CONTABILIDAD_INTERVALO_WORKER_SEG=15
# CONTABILIDAD_RESPUESTAS_TOPIC solo la usa el script manual de diagnostico
# (scripts/verRespuestasContabilidad.js, npm run contabilidad:respuestas) para mirar el
# topico del Grupo A a mano; el job real (src/jobs/respuestasContabilidad.js) usa
# CONTABILIDAD_RESPUESTAS_SUBSCRIPTION, que es una SUSCRIPCION (no un topico), ya creada
# por el equipo sobre ucb-sis323-sub-a -- pedirsela y pegarla aqui (vacio = no se leen).
CONTABILIDAD_RESPUESTAS_TOPIC=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-a
CONTABILIDAD_RESPUESTAS_SUBSCRIPTION=projects/project-a96e5fe1-5ba6-4698-a85/subscriptions/ucb-sis323-sub-a-sub
CONTABILIDAD_RESPUESTAS_INTERVALO_SEG=30
