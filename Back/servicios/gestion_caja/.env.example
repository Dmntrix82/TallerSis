PORT=4004
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxx
SESSION_INACTIVITY_MINUTES=15
FACTURACION_URL=http://localhost:4002
GESTION_PAGOS_URL=http://localhost:4005

# TDSI-52/698: aviso a Contabilidad (diferencia_caja) al resolver un faltante/sobrante,
# publicado en el topico de Contabilidad (Grupo D) -- mismo topico que usa facturacion
# para sus facturas (CONTABILIDAD_PUBSUB_TOPIC) (vacio = no se publica nada).
CONTABILIDAD_PUBSUB_TOPIC=projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-d
# Credencial (una de las dos; el .env nunca se sube): la misma cuenta de servicio que
# ya usan facturacion, gestion_pagos y pagos_proveedores (proyecto project-a96e5fe1-5ba6-4698-a85).
#  a) la llave pegada aqui en UNA sola linea y entre comillas simples (o en base64)
GOOGLE_CREDENTIALS_JSON=
#  b) ruta ABSOLUTA al JSON de la llave, guardado FUERA del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_TIMEOUT_MS=10000
# TDSI-52/700: respuestas de Contabilidad (resultado_documento) para marcar una
# diferencia Confirmada/Rechazada. Contabilidad publica esto en NUESTRO topico (Grupo A,
# ucb-sis323-sub-a); la suscripcion Pull es ucb-sis323-sub-a-sub (mismo patron
# "<topico>-sub" para cada grupo) -- misma que lee facturacion para sus propias
# respuestas, cada servicio filtra lo suyo y libera el resto.
CONTABILIDAD_RESPUESTAS_SUBSCRIPTION=projects/project-a96e5fe1-5ba6-4698-a85/subscriptions/ucb-sis323-sub-a-sub
CONTABILIDAD_RESPUESTAS_INTERVALO_SEG=30
